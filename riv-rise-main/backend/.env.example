DATABASE_URL=postgresql://user:password@localhost:5432/rise_gtm
JWT_SECRET=change-me-to-a-long-random-string
PORT=4100

# Supporting Material file uploads (18 Sep 2026 addendum, switched to S3
# credentials 19 Sep 2026) — Supabase Storage, same Supabase project as
# DATABASE_URL, accessed via its S3-compatible API rather than the regular
# Supabase API key (that path hit a Supabase-platform gap with this
# project's newer-format key — see supportingMaterialStorage.js). Get these
# four values from the Supabase dashboard: Project Settings > Storage > S3
# Connection > "New access key" generates SUPABASE_S3_ACCESS_KEY_ID and
# SUPABASE_S3_SECRET_ACCESS_KEY (shown once — copy immediately); the same
# page shows the Endpoint and Region to copy as-is. Server-side only —
# never send these to the frontend. Requires a private bucket named below
# to exist first; it is not created automatically.
SUPABASE_S3_ENDPOINT=https://your-project-ref.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=change-me
SUPABASE_S3_ACCESS_KEY_ID=change-me
SUPABASE_S3_SECRET_ACCESS_KEY=change-me
SUPABASE_SUPPORTING_MATERIAL_BUCKET=supporting-material
