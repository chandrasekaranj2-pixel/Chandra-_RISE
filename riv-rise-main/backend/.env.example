DATABASE_URL=postgresql://user:password@localhost:5432/rise_gtm
JWT_SECRET=change-me-to-a-long-random-string
PORT=4100

# Supporting Material file uploads (18 Sep 2026 addendum) — Supabase Storage,
# same Supabase project as DATABASE_URL. SUPABASE_URL is the project's API
# URL (Project Settings > API), SUPABASE_SERVICE_ROLE_KEY is the service_role
# key from the same page (server-side only — never send this to the
# frontend). Requires a private bucket named below to exist first; it is not
# created automatically.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=change-me
SUPABASE_SUPPORTING_MATERIAL_BUCKET=supporting-material
