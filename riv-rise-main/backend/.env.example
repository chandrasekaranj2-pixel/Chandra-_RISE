DATABASE_URL=postgresql://user:password@localhost:5432/rise_gtm
JWT_SECRET=change-me-to-a-long-random-string
PORT=4100

# Supporting Material file uploads (18 Sep 2026 addendum, switched to S3
# credentials 19 Sep 2026) — Supabase Storage, same Supabase project as
# DATABASE_URL, accessed via its S3-compatible API rather than the regular
# Supabase API key (that path hit a Supabase-platform gap with this
# project's newer-format key — see supportingMaterialStorage.js). Get these
# four values from the Supabase dashboard: Project Settings > Storage > S3
# Connection > "New access key" generates SUPABASE_S3_ACCESS_KEY_ID and
# SUPABASE_S3_SECRET_ACCESS_KEY (shown once — copy immediately); the same
# page shows the Endpoint and Region to copy as-is. Server-side only —
# never send these to the frontend. Requires a private bucket named below
# to exist first; it is not created automatically.
SUPABASE_S3_ENDPOINT=https://your-project-ref.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=change-me
SUPABASE_S3_ACCESS_KEY_ID=change-me
SUPABASE_S3_SECRET_ACCESS_KEY=change-me
SUPABASE_SUPPORTING_MATERIAL_BUCKET=supporting-material

# Introduction-request acknowledgement email (addendum) — sent via
# Resend's HTTP API (see backend/lib/email.js) after a startup submits
# "Request Intro". RESEND_API_KEY is a Resend API key (Dashboard > API
# Keys); EMAIL_FROM must be on a domain verified in Resend (Dashboard >
# Domains), or Resend will reject the send. If either is unset, the app
# logs a warning and skips sending instead of failing the request.
RESEND_API_KEY=change-me
EMAIL_FROM=notifications@your-verified-domain.com

# Emails to startups (the acknowledgement above, and the "Welcome to Retail
# Innovation Ventures" email sent when RIV marks a startup Onboarded) use
# this as their Reply-To, so replies reach the shared RIV inbox (RIOS uses
# the same address; RISE's mail is tagged app=rise in Resend). Defaults to
# contact@retailinnovation.ventures if unset.
ADMIN_NOTIFY_EMAIL=contact@retailinnovation.ventures
# Public URL of the portal, used for links in emails.
APP_URL=https://rise.retailinnovation.ai

# Notification emails (see lib/notify.js). All optional.
# RIV team alert emails to ADMIN_NOTIFY_EMAIL for partner-initiated requests
# and startup commit-status responses. Off unless set to "true".
RIV_ALERT_EMAILS=false
# Reminders to startups who haven't answered a New Opportunity (lib/reminders.js):
# set REMINDERS_ENABLED=false to switch off; days of silence before each
# reminder, and the most reminders sent per opportunity.
REMINDERS_ENABLED=true
OPPORTUNITY_REMINDER_DAYS=3
OPPORTUNITY_REMINDER_MAX=2
